{
  "ten": "book-zkp-snark-code",
  "sach": "zk-SNARK chuyên sâu -- IOP đa thức, cam kết đa thức và hệ chứng minh thế hệ mới",
  "python": "3.11 (chỉ thư viện chuẩn)",
  "snarklib": [
    {
      "module": "snarklib.ccs",
      "file": "snarklib/ccs.py",
      "mo_ta": "Customizable Constraint System (CCS) theo Setty–Thaler–Wahby."
    },
    {
      "module": "snarklib.curve",
      "file": "snarklib/curve.py",
      "mo_ta": "Đường cong toy E: y^2 = x^3 + x trên F_q, q = 5387 (siêu kỳ dị)."
    },
    {
      "module": "snarklib.dsl",
      "file": "snarklib/dsl.py",
      "mo_ta": "DSL tí hon mô tả mạch số học và biên dịch sang R1CS, Plonkish, CCS."
    },
    {
      "module": "snarklib.fft",
      "file": "snarklib/fft.py",
      "mo_ta": "NTT/INTT radix-2 (Cooley–Tukey) trên F_p có 2-adicity đủ lớn."
    },
    {
      "module": "snarklib.field",
      "file": "snarklib/field.py",
      "mo_ta": "Trường hữu hạn F_p và trường mở rộng bậc 2 F_q[i]/(i^2 + 1)."
    },
    {
      "module": "snarklib.folding",
      "file": "snarklib/folding.py",
      "mo_ta": "Chương 9 -- đệ quy, chu trình đường cong, số học không gốc và folding."
    },
    {
      "module": "snarklib.gf2tower",
      "file": "snarklib/gf2tower.py",
      "mo_ta": "Trường tháp nhị phân F_2 ⊂ F_4 ⊂ F_16 ⊂ F_256 theo cấu trúc Wiedemann (Binius)."
    },
    {
      "module": "snarklib.gkr",
      "file": "snarklib/gkr.py",
      "mo_ta": "Giao thức GKR cho mạch số học phân tầng (cổng cộng/nhân, fan-in 2)."
    },
    {
      "module": "snarklib.groth16",
      "file": "snarklib/groth16.py",
      "mo_ta": "Groth16 (Groth, EUROCRYPT 2016, Mục 3.2) trên đường cong toy của sách."
    },
    {
      "module": "snarklib.hang_so",
      "file": "snarklib/hang_so.py",
      "mo_ta": "Tính mọi hằng số xuyên suốt của sách bằng chính snarklib và ghi ket_qua/hang_so.txt."
    },
    {
      "module": "snarklib.hyrax",
      "file": "snarklib/hyrax.py",
      "mo_ta": "PCS kiểu Hyrax cho đa thức đa tuyến tính: cam kết ma trận √n × √n."
    },
    {
      "module": "snarklib.ipa",
      "file": "snarklib/ipa.py",
      "mo_ta": "Inner Product Argument (IPA) kiểu Bulletproofs và PCS dựng từ IPA."
    },
    {
      "module": "snarklib.kzg",
      "file": "snarklib/kzg.py",
      "mo_ta": "Cam kết đa thức KZG và các biến thể mở nhiều đa thức/nhiều điểm (Chương 3)."
    },
    {
      "module": "snarklib.ligero",
      "file": "snarklib/ligero.py",
      "mo_ta": "PCS kiểu Ligero cho đa thức đa tuyến tính (mã Reed–Solomon + Merkle)."
    },
    {
      "module": "snarklib.logup",
      "file": "snarklib/logup.py",
      "mo_ta": "LogUp: lookup bằng đạo hàm logarit (Chương 7, §7.2a và §7.3)."
    },
    {
      "module": "snarklib.merkle",
      "file": "snarklib/merkle.py",
      "mo_ta": "Cây Merkle nhị phân dùng SHA-256."
    },
    {
      "module": "snarklib.mle",
      "file": "snarklib/mle.py",
      "mo_ta": "Mở rộng đa tuyến tính (MLE) của bảng 2^l giá trị."
    },
    {
      "module": "snarklib.montgomery",
      "file": "snarklib/montgomery.py",
      "mo_ta": "Số học Montgomery: REDC, nhân Montgomery, chuyển vào/ra dạng Montgomery."
    },
    {
      "module": "snarklib.multiset",
      "file": "snarklib/multiset.py",
      "mo_ta": "Kiểm đa tập bằng tích (Chương 7, §7.1): nền của mọi lookup kiểu tích."
