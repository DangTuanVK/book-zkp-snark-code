    {
      "module": "snarklib.pairing",
      "file": "snarklib/pairing.py",
      "mo_ta": "Pairing Tate rút gọn (Type 1) trên nhóm con bậc r = 449 của E: y^2 = x^3 + x / F_5387."
    },
    {
      "module": "snarklib.pedersen",
      "file": "snarklib/pedersen.py",
      "mo_ta": "Cam kết Pedersen véc-tơ trên nhóm con bậc r = 449 của đường cong toy."
    },
    {
      "module": "snarklib.pippenger",
      "file": "snarklib/pippenger.py",
      "mo_ta": "MSM (multi-scalar multiplication) Σ s_i·P_i: Pippenger (phương pháp xô) và ngây thơ."
    },
    {
      "module": "snarklib.plonk",
      "file": "snarklib/plonk.py",
      "mo_ta": "mini-PLONK đầy đủ (Chương 6): 5 vòng Prover và 12 bước Verifier."
    },
    {
      "module": "snarklib.plonkish",
      "file": "snarklib/plonkish.py",
      "mo_ta": "Số học hóa Plonkish (kiểu PLONK gốc, 3 cột a, b, c)."
    },
    {
      "module": "snarklib.poly",
      "file": "snarklib/poly.py",
      "mo_ta": "Đa thức một biến trên F_p."
    },
    {
      "module": "snarklib.pst",
      "file": "snarklib/pst.py",
      "mo_ta": "KZG đa tuyến tính của Papamanthou–Shi–Tamassia (PST13), theo trình bày ở"
    },
    {
      "module": "snarklib.r1cs",
      "file": "snarklib/r1cs.py",
      "mo_ta": "Hệ ràng buộc bậc hai R1CS: (A z) ∘ (B z) = C z, với z = (1, x, w)."
    },
    {
      "module": "snarklib.spartan",
      "file": "snarklib/spartan.py",
      "mo_ta": "Mini-Spartan: zkSNARK (không ZK) cho R1CS bằng hai sum-check + PCS đa tuyến tính."
    },
    {
      "module": "snarklib.sumcheck",
      "file": "snarklib/sumcheck.py",
      "mo_ta": "Giao thức sum-check (Lund–Fortnow–Karloff–Nisan) và hai PIOP dựng trên nó."
    },
    {
      "module": "snarklib.transcript",
      "file": "snarklib/transcript.py",
      "mo_ta": "Transcript Fiat–Shamir dựa trên SHA-256 có tách miền (domain separation)."
    },
    {
      "module": "snarklib.uniqueness",
      "file": "snarklib/uniqueness.py",
      "mo_ta": "Kiểm tính duy nhất của witness cho R1CS nhỏ (Chương 12: an toàn mạch)."
    }
